# Copy to .env and edit:  cp .env.example .env
# This file feeds docker-compose.ugreen.yml. Keep real secrets out of git.

# --- Image -------------------------------------------------------------------
# Prebuilt image (recommended on a NAS). Pin a version instead of :latest for
# reproducible upgrades, e.g. ghcr.io/openclaw/openclaw:2026.5.17
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# --- Gateway auth ------------------------------------------------------------
# Shared secret the apps/browser use to pair with the gateway. Generate one:
#   openssl rand -hex 32
# Leave blank to let onboarding generate it for you, then copy it back here.
OPENCLAW_GATEWAY_TOKEN=

# --- Misc --------------------------------------------------------------------
# Your timezone (helps reminders/cron read naturally), e.g. America/Chicago
OPENCLAW_TZ=UTC

# Set to 1 only if LAN discovery misbehaves; 0 keeps Bonjour/mDNS on (host net).
OPENCLAW_DISABLE_BONJOUR=0

# --- Hosted Claude (optional; prefer `openclaw onboard` OAuth instead) --------
# If you use claude.ai session-key auth rather than OAuth, set these. Most users
# should leave them blank and run onboarding to sign in.
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=
